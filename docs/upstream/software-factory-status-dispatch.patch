+  await startRun(fresh);
+  await model.methods.approve.execute({
+    workItem: WI,
+    gateId: "abort-confirmation",
+    actor: "human",
+  }, fresh.context);
+  await model.methods.status.execute({ workItem: WI }, fresh.context);
