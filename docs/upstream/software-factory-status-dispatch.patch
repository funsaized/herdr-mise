+    (statusJson(fresh).transitions as { name: string; satisfied: boolean }[])
+      .find((t) => t.name === "abort")!.satisfied,
+  );
+  await model.methods.advance.execute(
+    { workItem: WI, transition: "abort" },
+    fresh.context,
+  );
+});
