{
  "name": "herdr-mise-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:visual": "vite --mode visual",
    "preview": "vite preview",
    "build": "tsc -b && node ../scripts/audit-pixi-architecture.mjs && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "audit:architecture": "node ../scripts/audit-pixi-architecture.mjs",
    "audit:accessibility": "node ../scripts/audit-accessibility.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "terser": "^5.51.2",
    "typescript": "~5.8.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
