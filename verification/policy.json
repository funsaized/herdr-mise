{
  "schemaVersion": 1,
  "workflow": {
    "id": "5cc04b4f-87b6-4168-ad49-ff184b6f65e1",
    "name": "local-verification"
  },
  "evidenceBranch": "ops/evidence",
  "maxAgeHours": 24,
  "configurationFiles": [
    ".github/CODEOWNERS",
    ".github/workflows/ci.yml",
    ".gitignore",
    ".prettierignore",
    ".swamp.yaml",
    "AGENTS.md",
    "Cargo.lock",
    "client/package-lock.json",
    "client/package.json",
    "extensions/models/herdr_mise_rust.ts",
    "extensions/models/upstream_extensions.json",
    "extensions/models/verification_evidence.ts",
    "models/@funsaized/herdr-mise-rust/verification-rust.yaml",
    "models/@funsaized/npm/project/verification-client.yaml",
    "models/@funsaized/npm/project/verification-root.yaml",
    "models/@funsaized/verification-evidence/verification-evidence.yaml",
    "models/@swamp/git/verification-evidence-git.yaml",
    "package-lock.json",
    "package.json",
    "scripts/verification-evidence.mjs",
    "scripts/verification-evidence.test.mjs",
    "scripts/workflow-contract.test.mjs",
    "verification/policy.json",
    "workflows/workflow-local-verification.yaml"
  ],
  "artifacts": ["client/dist", "target/release/herdr-mise"],
  "steps": [
    {
      "name": "dependencies-root",
      "modelName": "verification-root",
      "modelId": "e40b7444-cebe-4008-90a0-730a9e1137c0",
      "modelType": "@funsaized/npm/project",
      "method": "ci",
      "projectDir": ".",
      "argv": ["npm", "ci", "--no-audit", "--no-fund"],
      "outputs": ["invocation", "log"]
    },
    {
      "name": "dependencies-client",
      "modelName": "verification-client",
      "modelId": "eda1e433-a753-43a3-b17e-8ad4840e39d3",
      "modelType": "@funsaized/npm/project",
      "method": "ci",
      "projectDir": "client",
      "argv": ["npm", "ci", "--no-audit", "--no-fund"],
      "outputs": ["invocation", "log"]
    },
    {
      "name": "browser-install",
      "modelName": "verification-root",
      "modelId": "e40b7444-cebe-4008-90a0-730a9e1137c0",
      "modelType": "@funsaized/npm/project",
      "method": "run",
      "projectDir": ".",
      "argv": ["npm", "run", "verify:browser:install"],
      "outputs": ["invocation", "log"]
    },
    {
      "name": "fallback-assets-tests",
      "modelName": "verification-rust",
      "modelId": "ec39c096-17c8-4326-982d-42953b22bde8",
      "modelType": "@funsaized/herdr-mise-rust",
      "method": "fallbackAssets",
      "checks": ["test-fallback-assets"],
      "outputs": ["result"]
    },
    {
      "name": "format",
      "modelName": "verification-root",
      "modelId": "e40b7444-cebe-4008-90a0-730a9e1137c0",
      "modelType": "@funsaized/npm/project",
      "method": "run",
      "projectDir": ".",
      "argv": ["npm", "run", "format:check"],
      "outputs": ["invocation", "log"]
    },
    {
      "name": "build",
      "modelName": "verification-root",
      "modelId": "e40b7444-cebe-4008-90a0-730a9e1137c0",
      "modelType": "@funsaized/npm/project",
      "method": "run",
      "projectDir": ".",
      "argv": ["npm", "run", "build"],
      "outputs": ["invocation", "log"]
    },
    {
      "name": "rust-verification",
      "modelName": "verification-rust",
      "modelId": "ec39c096-17c8-4326-982d-42953b22bde8",
      "modelType": "@funsaized/herdr-mise-rust",
      "method": "verify",
      "checks": ["format", "check", "test"],
      "outputs": ["result"]
    },
    {
      "name": "typecheck",
      "modelName": "verification-root",
      "modelId": "e40b7444-cebe-4008-90a0-730a9e1137c0",
      "modelType": "@funsaized/npm/project",
      "method": "run",
      "projectDir": ".",
      "argv": ["npm", "run", "typecheck"],
      "outputs": ["invocation", "log"]
    },
    {
      "name": "lint",
      "modelName": "verification-root",
      "modelId": "e40b7444-cebe-4008-90a0-730a9e1137c0",
      "modelType": "@funsaized/npm/project",
      "method": "run",
      "projectDir": ".",
      "argv": ["npm", "run", "lint"],
      "outputs": ["invocation", "log"]
    },
    {
      "name": "unit-tests",
      "modelName": "verification-root",
      "modelId": "e40b7444-cebe-4008-90a0-730a9e1137c0",
      "modelType": "@funsaized/npm/project",
      "method": "run",
      "projectDir": ".",
      "argv": ["npm", "run", "test"],
      "outputs": ["invocation", "log"]
    },
    {
      "name": "compatibility",
      "modelName": "verification-root",
      "modelId": "e40b7444-cebe-4008-90a0-730a9e1137c0",
      "modelType": "@funsaized/npm/project",
      "method": "run",
      "projectDir": ".",
      "argv": ["npm", "run", "check:herdr-compatibility"],
      "outputs": ["invocation", "log"]
    },
    {
      "name": "browser-tests",
      "modelName": "verification-root",
      "modelId": "e40b7444-cebe-4008-90a0-730a9e1137c0",
      "modelType": "@funsaized/npm/project",
      "method": "run",
      "projectDir": ".",
      "argv": ["npm", "run", "test:visual"],
      "outputs": ["invocation", "log"]
    },
    {
      "name": "token-audit",
      "modelName": "verification-root",
      "modelId": "e40b7444-cebe-4008-90a0-730a9e1137c0",
      "modelType": "@funsaized/npm/project",
      "method": "run",
      "projectDir": ".",
      "argv": ["npm", "run", "audit:tokens"],
      "outputs": ["invocation", "log"]
    },
    {
      "name": "accessibility-audit",
      "modelName": "verification-root",
      "modelId": "e40b7444-cebe-4008-90a0-730a9e1137c0",
      "modelType": "@funsaized/npm/project",
      "method": "run",
      "projectDir": ".",
      "argv": ["npm", "run", "audit:accessibility"],
      "outputs": ["invocation", "log"]
    },
    {
      "name": "bundle-budget",
      "modelName": "verification-root",
      "modelId": "e40b7444-cebe-4008-90a0-730a9e1137c0",
      "modelType": "@funsaized/npm/project",
      "method": "run",
      "projectDir": ".",
      "argv": ["npm", "run", "check:bundle"],
      "outputs": ["invocation", "log"]
    },
    {
      "name": "bundle",
      "modelName": "verification-root",
      "modelId": "e40b7444-cebe-4008-90a0-730a9e1137c0",
      "modelType": "@funsaized/npm/project",
      "method": "run",
      "projectDir": ".",
      "argv": ["npm", "run", "bundle"],
      "outputs": ["invocation", "log"]
    },
    {
      "name": "release-validation",
      "modelName": "verification-root",
      "modelId": "e40b7444-cebe-4008-90a0-730a9e1137c0",
      "modelType": "@funsaized/npm/project",
      "method": "run",
      "projectDir": ".",
      "argv": ["npm", "run", "validate:release"],
      "outputs": ["invocation", "log"]
    }
  ]
}
