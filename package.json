{
  "name": "herdr-mise",
  "private": true,
  "license": "MIT",
  "author": "Funsaized",
  "scripts": {
    "doctor": "node scripts/check-environment.mjs",
    "build": "npm --prefix client run build --",
    "dev:visual": "npm --prefix client run dev:visual --",
    "bundle": "npm run build && cargo build --release --bin herdr-mise",
    "format": "oxfmt \"**/*.{ts,tsx,js,mjs,cjs,json,css,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,js,mjs,cjs,json,css,md}\"",
    "package": "sh scripts/package-release.sh",
    "smoke": "sh scripts/smoke-release.sh",
    "validate:release": "sh scripts/validate-release.sh",
    "measure:server": "sh scripts/measure-server.sh target/release/herdr-mise",
    "measure:tui": "python3 scripts/measure-tui.py",
    "typecheck": "npm --prefix client run typecheck",
    "lint": "oxlint --deny-warnings .",
    "test": "npm run test:unit && npm run test:release && npm --prefix client test",
    "test:unit": "node scripts/test-node.mjs unit",
    "bundle:prepared": "cargo build --release --locked --bin herdr-mise",
    "test:visual:prepared": "HERDR_MISE_PREBUILT=1 HERDR_MISE_CROSS_BROWSER=1 playwright test --config e2e/playwright.config.ts",
    "check:herdr-compatibility": "node scripts/check-herdr-compatibility.mjs",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "audit:architecture": "node scripts/audit-pixi-architecture.mjs",
    "audit:accessibility": "node scripts/audit-accessibility.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "perf": "playwright test --config perf/playwright.config.ts",
    "perf:endurance": "npm run bundle && HERDR_MISE_ENDURANCE=1 playwright test --config perf/playwright.config.ts --grep \"eight-hour production-boundary endurance matrix\"",
    "test:visual": "playwright test --config e2e/playwright.config.ts",
    "test:hosted": "HOSTED_VISUAL_URL=https://herdr-mise.s11a.com playwright test --config e2e/playwright.config.ts e2e/hosted-smoke.spec.ts",
    "test:acceptance": "node --test scripts/public-artifact.test.mjs",
    "verify:browser:install": "playwright install --with-deps chromium firefox webkit",
    "test:release": "node scripts/test-node.mjs release",
    "test:media": "node scripts/test-node.mjs media",
    "media": "node scripts/media/cli.mjs",
    "check": "npm run format:check && npm run typecheck && npm run lint",
    "audit": "npm run check:herdr-compatibility && npm run audit:tokens && npm run audit:accessibility",
    "verify": "npm run check && npm test && npm run audit && npm run verify:rust:fallback && npm run build && npm run verify:rust && npm run bundle:prepared && npm run check:bundle && npm run test:visual:prepared && npm run validate:release",
    "verify:rust": "cargo fmt --all --check && cargo clippy --workspace --locked --all-targets -- -D warnings && cargo test --workspace --locked",
    "verify:rust:fallback": "test ! -e target/fallback-dist/index.html && HERDR_MISE_DIST_DIR=\"$PWD/target/fallback-dist\" cargo test --workspace --locked"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0"
  }
}
