{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "proseWrap": "preserve",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/**",
    "client/node_modules/**",
    "AGENTS.md",
    "dist/**",
    "client/dist/**",
    "target/**",
    "server/target/**",
    "protocol/generated/**",
    "server/tests/fixtures/**",
    "THIRD_PARTY_NOTICES.txt",
    "client/public/**",
    "third_party/**",
    "package-lock.json",
    "client/package-lock.json",
    "Cargo.lock",
    ".hermes/**",
    ".scannerwork/**",
    ".cache/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "**/*.log",
    "**/*.tmp",
    "**/*.temp",
    "**/*-actual.*",
    "**/*-diff.*"
  ]
}
